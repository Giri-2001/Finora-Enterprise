{
  "name": "finora-enterprise",
  "version": "1.0.0",
  "private": true,
  "description": "FINORA Enterprise - Private Finance Management Platform",
  "author": "FINORA Enterprise",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && wait-on tcp:5173 && electron .",
    "build": "vite build && npm run electron:build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.finora.enterprise",
    "productName": "FINORA Enterprise",
    "icon": "assets/icons/finora.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
