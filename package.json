{
  "name": "finora-enterprise",
  "version": "1.0.2",
  "private": true,
  "description": "FINORA Enterprise - Private Finance Management Platform",
  "author": "FINORA Enterprise",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:electron:dev\"",
    "electron:build": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && wait-on tcp:5173 && electron .",
    "build": "node scripts/syncFinoraIncomePricing.mjs && vite build && npm run electron:build",
    "android:sync-recipient": "node scripts/syncAndroidRecipientAssets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource/cinzel": "^5.3.0",
    "dotenv": "^16.6.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "26.15.7",
    "electronmon": "^2.0.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.finora.enterprise",
    "productName": "FINORA Enterprise",
    "icon": "assets/icons/finora.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/control-center.html",
      "!dist/assets/controlCenter-*",
      "dist-electron/main.js",
      "dist-electron/preload.js",
      "dist-electron/finoraUsbResetScopePolicy.js",
      "dist-electron/control/**/*.js",
      "!dist-electron/control/**/*SelfTest.js",
      "!dist-electron/control/**/*E2E*.js",
      "dist-electron/notifications/**/*.js",
      "dist-electron/control-center/finoraControlCenterCanonicalization.js",
      "dist-electron/control-center/finoraControlCenterCrypto.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
